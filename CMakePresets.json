{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "CPPWINRT_BUILD_VERSION": "999.999.999.999",
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config"
    },

    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "ninja-base"
    },

    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CPPWINRT_CLANG": "ON"
      }
    },

    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "description": "Ninja Multi-Config with MSVC, x64",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "x64"
      }
    },
    {
      "name": "msvc-x86",
      "displayName": "MSVC x86",
      "description": "Ninja Multi-Config with MSVC, x86",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "x86"
      }
    },
    {
      "name": "msvc-arm64",
      "displayName": "MSVC ARM64",
      "description": "Ninja Multi-Config with MSVC, ARM64",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "arm64"
      }
    },

    {
      "name": "clang-cl-x64",
      "displayName": "ClangCL x64",
      "description": "Ninja Multi-Config with ClangCL, x64",
      "inherits": "clang-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "x64"
      }
    },
    {
      "name": "clang-cl-x86",
      "displayName": "ClangCL x86",
      "description": "Ninja Multi-Config with ClangCL, x86",
      "inherits": "clang-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "x86"
      }
    },
    {
      "name": "clang-cl-arm64",
      "displayName": "ClangCL ARM64",
      "description": "Ninja Multi-Config with ClangCL, ARM64",
      "inherits": "clang-base",
      "cacheVariables": {
        "CPPWINRT_EXPECTED_TARGET_ARCH": "arm64"
      }
    },

    {
      "name": "mingw",
      "displayName": "MinGW / llvm-mingw cross-compile",
      "description": "Cross-compile with mingw-w64 or llvm-mingw toolchain",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cross-mingw-toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "msvc-x64-debug",   "displayName": "MSVC x64 Debug",
      "configurePreset": "msvc-x64",   "configuration": "Debug"
    },
    {
      "name": "msvc-x64-release", "displayName": "MSVC x64 Release",
      "configurePreset": "msvc-x64",   "configuration": "Release"
    },
    {
      "name": "msvc-x86-debug",   "displayName": "MSVC x86 Debug",
      "configurePreset": "msvc-x86",   "configuration": "Debug"
    },
    {
      "name": "msvc-x86-release", "displayName": "MSVC x86 Release",
      "configurePreset": "msvc-x86",   "configuration": "Release"
    },
    {
      "name": "msvc-arm64-debug",   "displayName": "MSVC ARM64 Debug",
      "configurePreset": "msvc-arm64", "configuration": "Debug"
    },
    {
      "name": "msvc-arm64-release", "displayName": "MSVC ARM64 Release",
      "configurePreset": "msvc-arm64", "configuration": "Release"
    },
    {
      "name": "clang-cl-x64-debug",   "displayName": "ClangCL x64 Debug",
      "configurePreset": "clang-cl-x64",  "configuration": "Debug"
    },
    {
      "name": "clang-cl-x64-release", "displayName": "ClangCL x64 Release",
      "configurePreset": "clang-cl-x64",  "configuration": "Release"
    },
    {
      "name": "clang-cl-x86-debug",   "displayName": "ClangCL x86 Debug",
      "configurePreset": "clang-cl-x86",  "configuration": "Debug"
    },
    {
      "name": "clang-cl-x86-release", "displayName": "ClangCL x86 Release",
      "configurePreset": "clang-cl-x86",  "configuration": "Release"
    },
    {
      "name": "clang-cl-arm64-debug",   "displayName": "ClangCL ARM64 Debug",
      "configurePreset": "clang-cl-arm64","configuration": "Debug"
    },
    {
      "name": "clang-cl-arm64-release", "displayName": "ClangCL ARM64 Release",
      "configurePreset": "clang-cl-arm64","configuration": "Release"
    }
  ],

  "testPresets": [
    {
      "name": "msvc-x64-debug",   "configurePreset": "msvc-x64",
      "configuration": "Debug",   "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-x64-release", "configurePreset": "msvc-x64",
      "configuration": "Release", "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-x86-debug",   "configurePreset": "msvc-x86",
      "configuration": "Debug",   "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-x86-release", "configurePreset": "msvc-x86",
      "configuration": "Release", "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-cl-x64-debug",  "configurePreset": "clang-cl-x64",
      "configuration": "Debug",   "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-cl-x64-release","configurePreset": "clang-cl-x64",
      "configuration": "Release", "output": { "outputOnFailure": true }
    }
  ]
}
