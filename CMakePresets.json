{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CPPWINRT_BUILD_VERSION": "999.999.999.999",
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "vs-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022"
    },

    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "vs-base",
      "toolset": "host=x64"
    },

    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "vs-base",
      "toolset": "ClangCL,host=x64",
      "cacheVariables": {
        "CPPWINRT_CLANG": "ON"
      }
    },

    {
      "name": "msvc-x64",
      "displayName": "MSVC x64",
      "description": "Visual Studio 2022 MSVC, x64",
      "inherits": "msvc-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "msvc-x86",
      "displayName": "MSVC x86",
      "description": "Visual Studio 2022 MSVC, x86 (Win32)",
      "inherits": "msvc-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "msvc-arm64",
      "displayName": "MSVC ARM64",
      "description": "Visual Studio 2022 MSVC, ARM64",
      "inherits": "msvc-base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    },

    {
      "name": "clang-x64",
      "displayName": "ClangCL x64",
      "description": "Visual Studio 2022 ClangCL, x64",
      "inherits": "clang-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "clang-x86",
      "displayName": "ClangCL x86",
      "description": "Visual Studio 2022 ClangCL, x86 (Win32)",
      "inherits": "clang-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "clang-arm64",
      "displayName": "ClangCL ARM64",
      "description": "Visual Studio 2022 ClangCL, ARM64",
      "inherits": "clang-base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    },

    {
      "name": "mingw",
      "displayName": "MinGW / llvm-mingw cross-compile",
      "description": "Cross-compile with mingw-w64 or llvm-mingw toolchain",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cross-mingw-toolchain.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "msvc-x64-debug",   "displayName": "MSVC x64 Debug",
      "configurePreset": "msvc-x64",   "configuration": "Debug"
    },
    {
      "name": "msvc-x64-release", "displayName": "MSVC x64 Release",
      "configurePreset": "msvc-x64",   "configuration": "Release"
    },
    {
      "name": "msvc-x86-debug",   "displayName": "MSVC x86 Debug",
      "configurePreset": "msvc-x86",   "configuration": "Debug"
    },
    {
      "name": "msvc-x86-release", "displayName": "MSVC x86 Release",
      "configurePreset": "msvc-x86",   "configuration": "Release"
    },
    {
      "name": "msvc-arm64-debug",   "displayName": "MSVC ARM64 Debug",
      "configurePreset": "msvc-arm64", "configuration": "Debug"
    },
    {
      "name": "msvc-arm64-release", "displayName": "MSVC ARM64 Release",
      "configurePreset": "msvc-arm64", "configuration": "Release"
    },
    {
      "name": "clang-x64-debug",   "displayName": "ClangCL x64 Debug",
      "configurePreset": "clang-x64",  "configuration": "Debug"
    },
    {
      "name": "clang-x64-release", "displayName": "ClangCL x64 Release",
      "configurePreset": "clang-x64",  "configuration": "Release"
    },
    {
      "name": "clang-x86-debug",   "displayName": "ClangCL x86 Debug",
      "configurePreset": "clang-x86",  "configuration": "Debug"
    },
    {
      "name": "clang-x86-release", "displayName": "ClangCL x86 Release",
      "configurePreset": "clang-x86",  "configuration": "Release"
    },
    {
      "name": "clang-arm64-debug",   "displayName": "ClangCL ARM64 Debug",
      "configurePreset": "clang-arm64","configuration": "Debug"
    },
    {
      "name": "clang-arm64-release", "displayName": "ClangCL ARM64 Release",
      "configurePreset": "clang-arm64","configuration": "Release"
    }
  ],

  "testPresets": [
    {
      "name": "msvc-x64-debug",   "configurePreset": "msvc-x64",
      "configuration": "Debug",   "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-x64-release", "configurePreset": "msvc-x64",
      "configuration": "Release", "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-x64-debug",  "configurePreset": "clang-x64",
      "configuration": "Debug",   "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-x64-release","configurePreset": "clang-x64",
      "configuration": "Release", "output": { "outputOnFailure": true }
    }
  ]
}
